<div class="header">
    <div class="navToggleImg"><button onclick="openNav()"><img src="/img/navToggle.png"></button></div>
    <div><a href="<% if (user) { %>/<%= user.username %>/dashboard<% } else { %>/<% } %>"><img src="/img/logo.png"></a></div>
    <div class="userImg"><button><img src="/img/user.png"></button></div>
</div>
<div id="overlay" onclick="closeNav()"></div>
<div class="nav" id="nav">
    <div><img src="/img/tuxedotrades.png" style="width: 15em;"></div>
    <ul id="navOptions">
        <% if (user) { %>
            <li><img src=""><a href="/<%= user.username %>/dashboard">Dashboard</a></li>
            <li><img src=""><a href="/<%= user.username %>/transfer">Transfer</a></li>
            <li><img src=""><a href="/<%= user.username %>/history">Transaction History</a></li>
            <% if (user.admin) { %><li><img src=""><a href="/<%= user.admin %>/admin">Admin Settings</a></li><% } %>
            <li><img src=""><a href="/help">Help</a></li>
            <li><img src=""><a href="/about">About Us</a></li>
            <li><img src=""><button onclick="logoutUser()">Logout</button></li>
        <% } else { %>
            <li><img src=""><a href="/">Home</a></li>
            <li><img src=""><a href="/help">Help</a></li>
            <li><img src=""><a href="/about">About Us</a></li>
        <% } %>
    </ul>
</div>
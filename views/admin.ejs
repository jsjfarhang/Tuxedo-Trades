<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tuxedo Trades</title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <%- include('../blocks/nav') %>
  <div class="admin-container">
    <h2>Administrator Settings</h2>
    <p class="admin-italic">Unauthorized Access Prohibited</p><br>
	<p class="admin-lg">Create new stock</p><br>
  <div>
		<form class="admin-form" id="createStockForm">
			<p>Stock Ticker:</p>
			<input type="text" placeholder="Ticker" id="ticker" name="ticker" required>
			<p>Company:</p>
			<input type="text" placeholder="Company" id="company" name="company" required>
			<p>Volume:</p>
			<input type="number" placeholder="Volume" id="volume" name="volume" required>
			<p id="createStockError" class="error-text"></p>
			<input class="createStockSubmit" type="submit">
		</form>
  </div>
	<p class="admin-lg">Change Market Hours</p>
	<p class="admin-italic">Determines when users can buy/sell stocks.</p><br>
	<div>
		<form class="admin-form" id="hoursForm">
      <p>Open Time (HH:MM):</p>
      <input type="text" id="openTime" required>
      <p>Close Time (HH:MM):</p>
      <input type="text" id="closeTime" required><br><br>
      <button class="market-update" type="submit">Update Market Hours</button>
    </form>
  </div>
	<p class="admin-lg">Change Market Schedule</p>
	<p class="admin-italic">Determines when stock prices will be changing.</p><br>
	<div>
    <form class="admin-form" id="scheduleForm">
      <p>Holidays (YYYY/MM/DD, etc.):</p>
      <input type="text" id="holidays" required>
      <p>Open Days (Monday, Tuesday, etc.):</p>
      <input type="text" id="openDays" required><br><br>
      <button class="market-update" type="submit">Update Market Schedule</button>
    </form>
  </div>
  </div>
  <%- include('../blocks/footer') %>
  <script src="/js/admin.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      document.getElementById("createStockForm").addEventListener("submit", function(event) {
        event.preventDefault();
        const stockData = new FormData(this);
        addStock(stockData);
      })
    })
  </script>
</body>
</html>
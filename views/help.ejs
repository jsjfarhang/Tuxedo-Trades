<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tuxedo Trades</title>
  <link rel="stylesheet" href="css/global.css">
  <link rel="stylesheet" href="css/main.css">
</head>
<body>
  <%- include('../blocks/nav') %>
  <div class="helpbox">
    <header>Need Assistance?</header>
    <p>Fill out the form below and someone from our team will reach out!</p><br>
    <form class="helpform">
      <div class="leftform">
        <p>First Name:</p>
        <input type="text" placeholder="First Name"><br>
        <p>Last Name:</p>
        <input type="text" placeholder="Last Name"><br>
        <p>Email:</p>
        <input type="email" placeholder="TuxedoTim@example.com"><br>
        
      </div>
      <div class="rightform">
        <p>Issue Type:</p>
        <input list="Service Type" placeholder="Choose Service Type"><br>
        <datalist id="Service Type">
          <option value="Account">
          <option value="Technical">
          <option value="Billing">
          <option value="Other">
        </datalist>
        <p>How can we help?</p>
        <input class="servicetext" type="text"><br>
        <input type="submit">
      </div>
    </form>
  </div>
  <%- include('../blocks/footer') %>
  <script src="js/nav.js"></script>
  <script src="js/auth.js"></script>
</body>
</html>

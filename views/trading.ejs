<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tuxedo Trades</title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/trading.css">
  <link rel="stylesheet" href="/css/history.css">
</head>
<body> <!-- page requires extentions to change based on displayed stock -->
  <%- include('../blocks/nav') %>
  <div class="tradetable">
    <h1>Available Stocks</h1>
    <table id="historyTable">
      <thead>
        <tr>
          <th>Ticker</th>
          <th>Company</th>
          <th>Current Price</th>
          <th>Volume</th>
          <th>Market Cap</th>
          <th>Opening Price</th>
          <th>High</th>
          <th>Low</th>
          <th>Day Change</th>
          <th>Buy / Sell</th>
        </tr>
      </thead>
      <tbody>
        <% stocks.forEach(stock => { %>
          <tr data-ticker="<%= stock.ticker %>">
            <td><%= stock.ticker %></td>
            <td><%= stock.company %></td>
            <td>$<%= stock.history.at(-1)?.price.toLocaleString() %></td>
            <td><%= stock.volume %></td>
            <td><%= stock.marketCap.toLocaleString() %></td>
            <td class="opening">-</td>
            <td class="high">-</td>
            <td class="low">-</td>
            <td class="change">-</td>
            <td class="buysell">
              <button><a href='/<%= user.username %>/trading/<%= stock.ticker %>?action=buy'>BUY</a></button>
              <button><a href='/<%= user.username %>/trading/<%= stock.ticker %>?action=sell'>SELL</a></button>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <%- include('../blocks/footer') %>
  <script src="/js/dashboard.js"></script>
  <script>
    window.addEventListener('DOMContentLoaded', () => {
      displayAllDayChanges();
    });
  </script>
</body>
</html>

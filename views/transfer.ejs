<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tuxedo Trades</title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/transfer.css">
</head>
<body>
  <%- include('../blocks/nav') %>
  <div class="transferbox">
    <header>Account Transfers</header>
    <p>Specify your transaction and select "Submit" to process.</p><br>
    <p>Current Account Balance: <%= user.cashAccount.balance %></p><br>
    <form id="transfer">
      <input type="hidden" id="username" value="<%= user.username %>">
      <div class="leftform">
        <p>Transfer from:</p>
        <select id="transferFrom" required>
          <option value="" disabled selected>Choose Account</option>
          <option value="cashAccount">Account Balance: <%= user.cashAccount.balance %></option>
          <option value="bankAccount"><%= user.bankAccount.bankName %>: <%= user.bankAccount.balance %></option>
        </select><br>
        <p>Transfer to:</p>
        <select id="transferTo" required>
          <option value="" disabled selected>Choose Account</option>
          <option value="cashAccount">Account Balance: <%= user.cashAccount.balance %></option>
          <option value="bankAccount"><%= user.bankAccount.bankName %>: <%= user.bankAccount.balance %></option>
        </select>
      </div>
      <div class="rightform">
        <p>Amount:</p>
        <input id="amount" type="text" placeholder="Amount"><br>
        <p id="amountError" class="error-text"></p><br>
        <input type="submit">
      </div>
    </form>    
  </div>
  <%- include('../blocks/footer') %>
</body>
</html>

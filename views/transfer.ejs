<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tuxedo Trades</title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <%- include('../blocks/nav') %>
  <div class="helpbox">
    <header>Account Transfers</header>
    <p>Specify your transaction and select "Submit" to process.</p><br>
    <form class="Transfers">
      <div class="leftform">
        <p>Transfer from:</p>
        <input list="TransferList" placeholder="Choose Account"><br>
        <datalist id="TransferList">
          <option value="CHASE BANK SAVINGS">
          <option value="CHASE BANK CHECKING">
          <option value="Account Balance">
        </datalist>
        <p>Amount:</p>
        <input type="text" placeholder="Amount"><br>
      </div>
      
      <div class="rightform">
        <p>Transfer to:</p>
        <input list="TransferList" placeholder="Choose Account">
        <datalist id="TransferList">
          <option value="CHASE BANK SAVINGS">
          <option value="CHASE BANK CHECKING">
          <option value="Account Balance">
        </datalist>
        <p>Confirm Transfer:</p>
        <input type="submit">
      </div>
    </form>    
  </div>
  <%- include('../blocks/footer') %>
  <script src="/js/nav.js"></script>
  <script src="/js/auth.js"></script>
</body>
</html>

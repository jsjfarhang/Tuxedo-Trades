<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tuxedo Trades</title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/trading.css">
  <link rel="stylesheet" href="/css/history.css">
</head>
<body onload="console.log('test')"> <!-- page requires extentions to change based on displayed stock -->
  <%- include('../blocks/nav') %>
  <div class="tradetable">
    <h1><%= stock.ticker %> - <%= stock.company %></h1>
    <div id="transaction" class="lightbox">
        <div class="day-change">
          <p id="dayChange"></p>
        </div>
        <div class="transaction-items">
          <p>Transaction Type:</p>
          <select id="buySell" class="transaction-dropdown">
              <option value="buy">BUY</option>
              <option value="sell">SELL</option>
          </select>
        </div>
        <div class="transaction-items">
          <p>Amount:</p>
          <input id="purchaseAmount" class="transaction-input"></input>
        </div>
        <div class="transaction-items">
          <button onclick="buySell('<%= user.username %>', '<%= stock.ticker %>')">Confirm</button>
        </div>
        <div id="transactionError" class="error-text" style="display: flex; justify-content: center;"></div>
    </div>
    <table id="historyTable">
      <thead>
        <tr>
          <th>Date</th>
          <th>Price</th>
        </tr>
      </thead>
      <tbody>
        <% stock.history.slice().reverse().forEach(entry => { %>
            <tr>
                <td><%= entry.timestamp %></td>
                <td><%= entry.price %></td>
            </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <%- include('../blocks/footer') %>
  <script src="/js/dashboard.js"></script>
</body>
</html>

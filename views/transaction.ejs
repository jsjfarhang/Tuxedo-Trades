<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tuxedo Trades</title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/trading.css">
  <link rel="stylesheet" href="/css/history.css">
</head>
<body onload="console.log('test')"> <!-- page requires extentions to change based on displayed stock -->
  <%- include('../blocks/nav') %>
  <div class="tradetable">
    <h1><%= stock.ticker %> - <%= stock.company %></h1>
    <div id="transaction" class="lightbox">
        <div class="day-change">
          <p id="dayChange"></p>
        </div>
        <div class="transaction-items">
            <p>Transaction Type:</p>
            <select class="transaction-dropdown">
                <option value="buy">BUY</option>
                <option value="sell">SELL</option>
            </select>
            <button onclick="buySell(stock)">Confirm</button>
        </div>
        <div class="transaction-items">
            <p>Amount:</p>
            <input class="transaction-input"></input>
        </div>
    </div>
    <table id="historyTable">
      <thead>
        <tr>
          <th>Date</th>
          <th>Price</th>
        </tr>
      </thead>
      <tbody>
        <% stock.history.slice().reverse().forEach(entry => { %>
            <tr>
                <td><%= entry.timestamp %></td>
                <td><%= entry.price %></td>
            </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <%- include('../blocks/footer') %>
  <script src="/js/transaction.js"></script>
</body>
</html>
